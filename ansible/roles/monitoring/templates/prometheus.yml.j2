global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  # JMX exporter de cada broker
{% for host in groups['brokers'] %}
  - job_name: 'kafka-broker-{{ hostvars[host]["node_id"] }}'
    static_configs:
      - targets: ['{{ hostvars[host]["broker_ip"] }}:9100']
        labels:
          broker: '{{ host }}'
          node_id: '{{ hostvars[host]["node_id"] }}'
{% endfor %}

  # Kafka exporter (consumer lag / estado consumer groups)
  - job_name: 'kafka-exporter'
    static_configs:
      - targets: ['localhost:9308']

  # Métricas del propio nodo de monitoreo (CPU/RAM/disco)
  - job_name: node
    static_configs:
      - targets: ['localhost:9101']