{
  "id": null,
  "uid": "kafka-tolerancia-fallos-tp01",
    "title": "Kafka Tolerancia a Fallos (TP01)",
    "tags": ["kafka", "tp01"],
    "timezone": "utc",
    "schemaVersion": 39,
    "refresh": "5s",
    "time": { "from": "now-30m", "to": "now" },
    "timepicker": {},
    "templating": {
      "list": [
        {
          "name": "topic",
          "label": "Topic",
          "type": "query",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "query": "label_values(kafka_consumergroup_lag, topic)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": false,
          "current": { "text": "orders", "value": "orders" }
        },
        {
          "name": "consumer_group",
          "label": "Consumer group",
          "type": "query",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "query": "label_values(kafka_consumergroup_lag, consumergroup)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": false,
          "current": { "text": "order-processor-group", "value": "order-processor-group" }
        },
        {
          "name": "broker",
          "label": "Broker",
          "type": "query",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "query": "label_values(up{job=~\"kafka-broker-.*\"}, broker)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": false,
          "current": { "text": "All", "value": "$__all" }
        }
      ]
    },
    "annotations": { "list": [] },
    "editable": true,
    "panels": [
      {
        "id": 1,
        "title": "Under-replicated partitions",
        "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "max(kafka_server_replicamanager_underreplicatedpartitions)", "legendFormat": "under-replicated", "refId": "A" }
        ],
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
        "fieldConfig": { "defaults": {}, "overrides": [] },
        "options": {}
      },
      {
        "id": 2,
        "title": "Offline partitions",
        "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "max(kafka_controller_kafkacontroller_offlinepartitionscount)", "legendFormat": "offline", "refId": "B" }
        ],
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
        "fieldConfig": { "defaults": {}, "overrides": [] },
        "options": {}
      },
      {
        "id": 3,
        "title": "Active controller (debe ser 1)",
        "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "max(kafka_controller_kafkacontroller_activecontrollercount)", "legendFormat": "ctl", "refId": "C" }
        ],
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 7 },
        "fieldConfig": { "defaults": {}, "overrides": [] },
        "options": {}
      },
      {
        "id": 4,
        "title": "Consumer lag (por grupo)",
        "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "sum(kafka_consumergroup_lag{topic=~\"$topic\",consumergroup=~\"$consumer_group\"})", "legendFormat": "lag", "refId": "D" }
        ],
        "gridPos": { "h": 5, "w": 12, "x": 12, "y": 7 },
        "fieldConfig": { "defaults": {}, "overrides": [] },
        "options": {}
      },
      {
        "id": 5,
        "title": "Throughput mensajes (cluster)",
        "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "sum(rate(kafka_server_brokertopicmetrics_messagesin_total[30s]))", "legendFormat": "msg/s", "refId": "E" }
        ],
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 13 },
        "fieldConfig": { "defaults": {}, "overrides": [] },
        "options": {}
      },
      {
        "id": 6,
        "title": "ISR shrinks (fallos de réplica)",
        "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "sum(rate(kafka_server_replicamanager_isrshrinks_total[30s]))", "legendFormat": "shrinks/s", "refId": "F" }
        ],
        "gridPos": { "h": 5, "w": 12, "x": 12, "y": 13 },
        "fieldConfig": { "defaults": {}, "overrides": [] },
        "options": {}
      },
      {
        "id": 7,
        "title": "Bytes de entrada (cluster)",
        "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "sum(rate(kafka_server_brokertopicmetrics_bytesin_total[30s]))", "legendFormat": "bytes/s", "refId": "G" }
        ],
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 19 },
        "fieldConfig": { "defaults": {}, "overrides": [] },
        "options": {}
      },
      {
        "id": 8,
        "title": "Brokers activos",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "up{job=~\"kafka-broker-.*\",broker=~\"$broker\"}", "legendFormat": "{{broker}}", "refId": "H" }
        ],
        "gridPos": { "h": 5, "w": 12, "x": 12, "y": 19 },
        "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
        "options": {}
      },
      {
        "id": 9,
        "title": "CPU del monitor",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "CPU %", "refId": "I" }
        ],
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 24 },
        "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
        "options": {}
      },
      {
        "id": 10,
        "title": "Memoria del monitor",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "Memoria %", "refId": "J" }
        ],
        "gridPos": { "h": 5, "w": 12, "x": 12, "y": 24 },
        "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
        "options": {}
      }
    ]
}